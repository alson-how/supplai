// SupplAI persistence schema. Aligned 1:1 with the domain models in
// src/domain so the Prisma-backed repositories map without translation.
// Monetary and quantity fields use Float (JS number) to keep the repository
// layer free of Decimal conversions; a production build can tighten these to
// Decimal with explicit mappers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  COMMERCIAL_PLANNER
  SUPPLY_CHAIN_PLANNER
  PRODUCTION_PLANNER
  LOGISTICS_PLANNER
  EXECUTIVE_VIEWER
}

model Organisation {
  id           String    @id
  name         String
  country      String
  baseCurrency String    @default("USD")
  timezone     String    @default("Asia/Kuala_Lumpur")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  users        User[]
  products     Product[]
}

model User {
  id             String   @id
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organisationId])
}

model Product {
  id                    String   @id
  organisationId        String
  organisation          Organisation @relation(fields: [organisationId], references: [id])
  code                  String
  name                  String
  category              String
  polymerType           String
  grade                 String
  application           String
  unitOfMeasure         String   @default("TONNE")
  productionCostPerUnit Float
  minimumOrderQuantity  Float
  shelfLifeDays         Int
  status                String   @default("ACTIVE")

  @@unique([organisationId, code])
}

model Market {
  id                String  @id
  organisationId    String
  country           String
  region            String
  marketSegment     String
  currency          String
  riskScore         Float
  strategicPriority Float
  status            String  @default("ACTIVE")

  @@index([organisationId, country])
}

model Customer {
  id                 String  @id
  organisationId     String
  marketId           String
  code               String
  name               String
  segment            String
  industry           String
  creditLimit        Float
  outstandingCredit  Float
  priorityScore      Float
  strategicAccount   Boolean
  paymentRiskScore   Float
  serviceLevelTarget Float
  status             String  @default("ACTIVE")

  @@unique([organisationId, code])
  @@index([organisationId, marketId])
}

model InventoryLocation {
  id             String @id
  organisationId String
  code           String
  name           String
  country        String
  locationType   String

  @@unique([organisationId, code])
}

model InventoryPosition {
  id                      String   @id
  organisationId          String
  productId               String
  locationId              String
  availableQuantity       Float
  reservedQuantity        Float
  qualityHoldQuantity     Float
  expectedInboundQuantity Float
  inventoryAgeDays        Int
  snapshotDate            String

  @@index([organisationId, productId])
}

model ProductionFacility {
  id               String @id
  organisationId   String
  code             String
  name             String
  country          String
  capacityPerPeriod Float
  status           String

  @@unique([organisationId, code])
}

model ProductionPlan {
  id                 String  @id
  organisationId     String
  facilityId         String
  productId          String
  planningPeriod     String
  plannedQuantity    Float
  confirmedQuantity  Float
  availableQuantity  Float
  productionReadyDate String
  changeoverRequired Boolean
  changeoverCost     Float
  status             String

  @@index([organisationId, planningPeriod])
}

model LogisticsRoute {
  id                   String  @id
  organisationId       String
  originLocationId     String
  destinationMarketId  String
  transportMode        String
  estimatedLeadTimeDays Int
  capacityPerPeriod    Float
  freightCostPerUnit   Float
  handlingCostPerUnit  Float
  carbonCostPerUnit    Float
  reliabilityScore     Float
  active               Boolean

  @@index([organisationId, destinationMarketId, active])
}

model MarketPriceSignal {
  id                 String @id
  organisationId     String
  productId          String
  marketId           String
  signalDate         String
  marketPricePerUnit Float
  currency           String
  source             String
  reliabilityScore   Float
  trend              String
  percentageChange   Float

  @@index([organisationId, signalDate])
}

model MarketSignal {
  id             String @id
  organisationId String
  marketId       String
  productId      String
  title          String
  signalType     String
  summary        String
  sentiment      String
  impactScore    Float
  source         String
  observedAt     String

  @@index([organisationId, observedAt])
}

model Scenario {
  id                 String   @id
  organisationId     String
  name               String
  description        String
  scenarioType       String
  baselineScenarioId String?
  status             String
  assumptions        Json
  lastRun            Json?
  createdBy          String
  createdAt          String
  updatedAt          String
  executedAt         String?
  recommendations    ScenarioRecommendation[]

  @@index([organisationId, status])
}

model ScenarioRecommendation {
  id               String   @id
  organisationId   String
  scenarioId       String
  scenario         Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  runId            String
  rank             Int
  opportunityId    String
  productId        String
  customerId       String
  marketId         String
  product          String
  customer         String
  market           String
  route            String
  quantity         Float
  price            Float
  revenue          Float
  netMargin        Float
  marginPercent    Float
  leadTimeDays     Int
  confidence       Float
  feasibility      String
  status           String
  rationale        String
  explanation      String
  constraints      Json
  originalQuantity Float?
  decisionReason   String?
  decidedBy        String?
  decidedAt        String?

  @@index([organisationId, scenarioId])
}

model AuditLog {
  id             String  @id
  organisationId String
  userId         String
  entityType     String
  entityId       String
  action         String
  beforeJson     Json?
  afterJson      Json?
  createdAt      String

  @@index([organisationId, createdAt])
}
